// The window of OnyxDiskInfo. It shows one drive at a time, in the layout of
// CrystalDiskInfo: the drives at the top, the health and the temperature on
// the left, the details on the right, and the attributes under them.

import { Button, Palette, ScrollView } from "std-widgets.slint";
import { Theme, ThemePreference, Verdict } from "theme.slint";
import { AppData, Logic, DriveTab, InfoRow, AttributeRow } from "data.slint";
import { DriveTabButton, Badge, AttributeTable } from "widgets.slint";

export { AppData, Logic, DriveTab, InfoRow, AttributeRow, Theme, ThemePreference, Verdict }

// The icon in the tray, the notification area, or the menu bar. It keeps
// the app reading the drives after the window closes.
export component OnyxTray inherits SystemTrayIcon {
    icon: @image-url("../../../assets/logo.svg");
    in property <string> summary: "OnyxDiskInfo";
    tooltip: root.summary;
    callback show-window();
    callback read-now();
    callback quit();

    Menu {
        MenuItem {
            title: "Show OnyxDiskInfo";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "Read the drives now";
            activated => { root.read-now(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "OnyxDiskInfo";
    icon: @image-url("../../../assets/logo.svg");
    preferred-width: 880px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 480px;
    background: Theme.background;
    default-font-size: Theme.font-size;

    // A chosen scheme reaches the standard widgets, such as the buttons,
    // through their palette.
    property <ThemePreference> preference: Theme.preference;
    changed preference => { self.apply-preference(); }
    init => { self.apply-preference(); }
    function apply-preference() {
        if Theme.preference == ThemePreference.dark {
            Palette.color-scheme = ColorScheme.dark;
        } else if Theme.preference == ThemePreference.light {
            Palette.color-scheme = ColorScheme.light;
        }
    }

    VerticalLayout {
        padding: Theme.gap-large;
        spacing: Theme.gap;

        // The drives.
        HorizontalLayout {
            spacing: Theme.gap-small;
            for tab[index] in AppData.tabs: DriveTabButton {
                title: tab.title;
                temperature: tab.temperature;
                verdict: tab.verdict;
                verdict-text: tab.verdict-text;
                selected: index == AppData.current;
                clicked => { Logic.select(index); }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button {
                    text: AppData.busy ? "Reading" : "Refresh";
                    enabled: !AppData.busy;
                    clicked => { Logic.refresh(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: AppData.name;
            color: Theme.text;
            font-size: Theme.title-font-size;
            font-weight: 700;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: Theme.gap-large;
            vertical-stretch: 0;

            VerticalLayout {
                width: 170px;
                spacing: Theme.gap;
                Badge {
                    label: "Health Status";
                    value: AppData.verdict-text;
                    detail: AppData.confidence == "-" ? "" : "Confidence: " + AppData.confidence;
                    fill: Theme.verdict-color(AppData.verdict);
                    ink: Theme.verdict-text-color(AppData.verdict);
                }
                Badge {
                    label: "Temperature";
                    value: AppData.temperature;
                    detail: "";
                    fill: Theme.verdict-color(AppData.temperature-verdict);
                    ink: Theme.verdict-text-color(AppData.temperature-verdict);
                }
            }

            VerticalLayout {
                spacing: Theme.gap-small;
                horizontal-stretch: 1;
                for row in AppData.info: HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        width: 130px;
                        text: row.label;
                        color: Theme.muted-text;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: row.value;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
                Text {
                    text: AppData.source == "-" ? "" : "Source: " + AppData.source;
                    color: Theme.muted-text;
                    font-size: Theme.small-font-size;
                }
                for reason in AppData.reasons: Text {
                    text: "- " + reason;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if AppData.message != "": HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        text: AppData.message;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if AppData.needs-rights: Button {
                        text: "Read as administrator";
                        clicked => { Logic.read-with-rights(); }
                    }
                }
            }
        }

        // The history: the temperature over time, and the newest alerts.
        if AppData.trend-text != "" || AppData.alerts.length > 0: HorizontalLayout {
            spacing: Theme.gap-large;
            height: 92px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap-small;
                Text {
                    text: AppData.trend-text;
                    color: Theme.muted-text;
                    font-size: Theme.small-font-size;
                    overflow: elide;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius;
                    if AppData.trend-commands != "": Path {
                        x: Theme.gap;
                        y: Theme.gap-small;
                        width: parent.width - 2 * Theme.gap;
                        height: parent.height - 2 * Theme.gap-small;
                        commands: AppData.trend-commands;
                        viewbox-width: 1000;
                        viewbox-height: 100;
                        stroke: Theme.verdict-color(Verdict.good);
                        stroke-width: 2px;
                        accessible-role: image;
                        accessible-label: AppData.trend-text;
                    }
                }
            }
            VerticalLayout {
                width: 320px;
                spacing: Theme.gap-small;
                Text {
                    text: AppData.alerts.length == 0 ? "No alert in the history." : "Alerts";
                    color: Theme.muted-text;
                    font-size: Theme.small-font-size;
                }
                for alert in AppData.alerts: Text {
                    text: alert;
                    color: Theme.text;
                    font-size: Theme.small-font-size;
                    wrap: word-wrap;
                }
            }
        }

        AttributeTable {
            vertical-stretch: 1;
            min-height: 160px;
            rows: AppData.rows;
        }
    }
}
